# Copy to .env and fill in. Never commit .env.
#
# A funded testnet account from portal.hedera.com. Used as a faucet to create
# the buyer account, and as the x402 seller's payTo. The buyer account itself
# is created with the Ledger's own public key, so this key cannot spend it.
HEDERA_NETWORK=testnet
HEDERA_TREASURY_ID=0.0.xxxxxxx
HEDERA_TREASURY_EVM=0x...
HEDERA_TREASURY_KEY=0x...

X402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_MIRROR=https://testnet.mirrornode.hedera.com/api/v1
