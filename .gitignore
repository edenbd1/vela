# Ledger app build artifacts
app/build/
app/bin/
app/debug/
app/dep/
app/src/glyphs.[ch]
app/glyphs/home_vela_*.gif

# Node
node_modules/
dist/
*.log

# Secrets — jamais commités
.env
.env.*
!.env.example
*.enc.key
out/

# OS
.DS_Store

# Member private key for the Key Ring — never commit
host/ring/.member.json

# The trustchain is sealed under the Key Ring, so committing it would leak
# nothing — but it is the fleet's membership roster, and a roster is worth
# reading even when the keys in it are not. Bundles carry sealed secrets,
# which are only as private as the members list they were sealed for.
host/ring/trustchain.enc
host/ring/bundle-*.json
# The device-rooted chain holds no private key at all — the owner is the
# Secure Element — but it is the same roster, and it names every host a tap
# admitted.
host/ring/trustchain.device.json

# Node
hedera/node_modules/
host/ring/node_modules/

# host bookkeeping: which grant epoch the live mandate belongs to
.vela-instance

# Device interaction journal: local evidence, not source.
.vela-journal.jsonl

# Broker secrets: ciphertext is fine to commit, plaintext is not.
broker/secrets/*.dev

# Per-agent quota counters: runtime state, not source.
broker/usage.json

# Operator credential, minted per gateway run.
.vela-operator-token

# The fleet's terms, for restoring onto a replacement device. No secret is in
# it — an agent id, a budget, a ceiling, a payee — but it names the fleet, and
# recover.mjs checks it against the chain rather than trusting it, so a copy
# in the repository would be a stale one waiting to confuse someone.
.vela-fleet-backup.json

# What each agent remembers between runs. Local state, and the point of the
# poisoning demo is that anything which can write here can write to it.
.vela-memory/
vela-console/
