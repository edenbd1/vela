# Ledger app build artifacts
app/build/
app/bin/
app/debug/
app/dep/
app/src/glyphs.[ch]
app/glyphs/home_vela_*.gif

# Node
node_modules/
dist/
*.log

# Secrets — jamais commités
.env
.env.*
!.env.example
*.enc.key
out/

# OS
.DS_Store

# Member private key for the Key Ring — never commit
host/ring/.member.json

# The trustchain is sealed under the Key Ring, so committing it would leak
# nothing — but it is the fleet's membership roster, and a roster is worth
# reading even when the keys in it are not. Bundles carry sealed secrets,
# which are only as private as the members list they were sealed for.
host/ring/trustchain.enc
host/ring/bundle-*.json

# Node
hedera/node_modules/
host/ring/node_modules/

# host bookkeeping: which grant epoch the live mandate belongs to
.vela-instance

# Device interaction journal: local evidence, not source.
.vela-journal.jsonl

# Broker secrets: ciphertext is fine to commit, plaintext is not.
broker/secrets/*.dev

# Per-agent quota counters: runtime state, not source.
broker/usage.json

# Operator credential, minted per gateway run.
.vela-operator-token
